{
  "name": "@sandboxfile/schema",
  "version": "0.1.0-alpha.0",
  "description": "JSON Schemas for the open SandboxFile specification",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "spec/v1alpha1/*",
    "README.md",
    "SPECIFICATION.md",
    "LICENSE"
  ],
  "exports": {
    "./v1alpha1/SandboxFile.schema.json": "./spec/v1alpha1/SandboxFile.schema.json",
    "./v1alpha1/SandboxFile.lock.schema.json": "./spec/v1alpha1/SandboxFile.lock.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "generate:check": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc -b",
    "test:conformance": "node scripts/check-conformance.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "check": "pnpm generate:check && pnpm typecheck && pnpm test:conformance && pnpm pack:check"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  }
}
