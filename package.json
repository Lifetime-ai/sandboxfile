{
  "name": "@sandboxfile/schema",
  "version": "0.1.0-alpha.0",
  "description": "JSON Schemas for the open SandboxFile specification",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lifetime-ai/sandboxfile.git"
  },
  "homepage": "https://github.com/Lifetime-ai/sandboxfile#readme",
  "bugs": {
    "url": "https://github.com/Lifetime-ai/sandboxfile/issues"
  },
  "keywords": [
    "ai-agents",
    "sandbox",
    "specification",
    "security",
    "developer-tools"
  ],
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "spec/v1alpha1/*",
    "README.md",
    "SPECIFICATION.md",
    "LICENSE"
  ],
  "exports": {
    "./v1alpha1/SandboxFile.schema.json": "./spec/v1alpha1/SandboxFile.schema.json",
    "./v1alpha1/SandboxFile.lock.schema.json": "./spec/v1alpha1/SandboxFile.lock.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "generate:check": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc -b",
    "test:conformance": "node scripts/check-conformance.mjs",
    "test:workflows": "node scripts/check-workflows.mjs",
    "validate": "node packages/validator/src/cli.js validate",
    "pack:check": "node scripts/check-package.mjs",
    "check": "pnpm generate:check && pnpm typecheck && pnpm test:conformance && pnpm test:workflows && pnpm pack:check"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "yaml": "^2.8.1"
  }
}
