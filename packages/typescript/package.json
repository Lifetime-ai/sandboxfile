{
  "name": "@sandboxfile/types",
  "version": "0.1.0-alpha.0",
  "description": "Generated TypeScript types for the SandboxFile specification",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b --force",
    "typecheck": "tsc -b --pretty false"
  }
}
